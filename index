<section class="page" aria-label="Logo suite">
  <div class="sheet">
    <div class="head"><img data-a="lockup-red" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt=""><span class="label sec">02 — Logo Suite</span></div>
