<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Community Marshall Brand Board</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
@font-face{font-family:"Montserrat";font-weight:500;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Montserrat";font-weight:600;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Montserrat";font-weight:800;font-style:normal;font-display:block;src:url(data:font/woff2;base64,) format("woff2")}

/* Layout: a bound set of 16:10 guideline sheets, like a club charter. Red is the voice, white is the room it speaks in. */
:root{
  --red:#c41618;
  --red-deep:#9e1013;
  --white:#ffffff;
  --ink:#1d1213;          /* warm near-black, biased toward the red */
  --muted:#6f5f60;        /* body secondary */
  --hair:#ead9d9;         /* hairline rules on white */
  --desk:#efebea;         /* the surface the sheets sit on */
  --font:"Montserrat","Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
body{margin:0;background:var(--desk);color:var(--ink);font-family:var(--font);font-weight:500;-webkit-font-smoothing:antialiased;-webkit-print-color-adjust:exact;print-color-adjust:exact}

.deck{display:flex;flex-direction:column;align-items:center;gap:40px;padding-block:40px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* Each sheet is a container; 1u = 1% of sheet width (14.4px on a full sheet). */
.page{container-type:inline-size;width:100%;max-width:1440px;aspect-ratio:16/10;background:var(--white);position:relative;overflow:hidden;box-shadow:0 1px 2px rgba(80,20,20,.06),0 18px 50px -20px rgba(80,20,20,.22)}
.sheet{--u:1cqw;position:absolute;inset:0;display:flex;flex-direction:column;padding:calc(var(--u)*3.6) calc(var(--u)*4.4)}

/* type scale */
.sheet{--t-mega:max(40px,calc(var(--u)*6.2));--t-hero:max(30px,calc(var(--u)*3.9));--t-h2:max(22px,calc(var(--u)*2.5));--t-h3:max(14px,calc(var(--u)*1.12));--t-body:max(13px,calc(var(--u)*.9));--t-small:max(11px,calc(var(--u)*.74));--t-label:max(10px,calc(var(--u)*.64))}
h1,h2,h3,p{margin:0}
h1,h2{font-weight:800;letter-spacing:-.01em;line-height:1.04;text-wrap:balance}
h3{font-weight:600;font-size:var(--t-h3);line-height:1.25}
p{font-size:var(--t-body);line-height:1.62;color:var(--muted);max-width:62ch}
.label{font-weight:600;font-size:var(--t-label);letter-spacing:.32em;text-transform:uppercase}

/* running head and foot */
.head,.foot{display:flex;justify-content:space-between;align-items:center;gap:16px}
.head{padding-bottom:calc(var(--u)*1.1);border-bottom:1px solid var(--hair)}
.head img{height:max(18px,calc(var(--u)*1.9));width:auto}
.head .label,.foot .label{color:var(--muted)}
.head .sec{color:var(--red)}
.foot{margin-top:auto;padding-top:calc(var(--u)*1.1)}
.body{flex:1;display:flex;flex-direction:column;padding-top:calc(var(--u)*2.6);min-height:0}
.eyebrow{color:var(--red);margin-bottom:calc(var(--u)*1.1)}

/* ---------- 1 cover ---------- */
.cover{background:var(--red);color:var(--white)}
.cover .ghost{position:absolute;right:calc(var(--u)*-11);top:50%;transform:translateY(-50%);width:calc(var(--u)*58);opacity:.09;pointer-events:none}
.cover .top,.cover .bottom{display:flex;justify-content:space-between;gap:24px;position:relative}
.cover .label{color:rgba(255,255,255,.82)}
.cover .mid{flex:1;display:flex;flex-direction:column;justify-content:center;gap:calc(var(--u)*3);position:relative}
.cover .mid img{width:calc(var(--u)*52);max-width:100%}
.cover .rule{width:calc(var(--u)*6);height:3px;background:var(--white)}
.cover .bottom{align-items:flex-end;border-top:1px solid rgba(255,255,255,.35);padding-top:calc(var(--u)*1.4)}
.cover .bottom p{color:var(--white);font-weight:600;font-size:var(--t-h3);max-width:38ch;line-height:1.45}

/* ---------- 2 essence ---------- */
.essence{display:grid;grid-template-columns:1.15fr 1fr;gap:calc(var(--u)*5);flex:1;min-height:0}
.essence h2{font-size:var(--t-hero);margin-bottom:calc(var(--u)*2)}
.essence h2 em{font-style:normal;color:var(--red)}
.essence .left{display:flex;flex-direction:column;min-width:0}
.essence .left p+p{margin-top:calc(var(--u)*1)}
.focus{margin-top:auto;display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid var(--ink)}
.focus div{padding:calc(var(--u)*1.1) calc(var(--u)*1) 0 0;border-right:1px solid var(--hair);min-width:0}
.focus div+div{padding-left:calc(var(--u)*1)}
.focus div:last-child{border-right:0}
.focus b{display:block;font-weight:800;font-size:var(--t-h3);color:var(--red);margin-bottom:4px}
.focus span{font-size:var(--t-small);color:var(--muted);line-height:1.45;display:block}
.message{background:var(--red);color:var(--white);display:flex;flex-direction:column;justify-content:space-between;padding:calc(var(--u)*3);min-width:0}
.message .label{color:rgba(255,255,255,.8)}
.message blockquote{margin:0;font-weight:800;font-size:var(--t-h2);line-height:1.12;letter-spacing:-.01em;text-wrap:balance}
.values{display:flex;flex-wrap:wrap;gap:8px}
.values span{font-weight:600;font-size:var(--t-label);letter-spacing:.24em;text-transform:uppercase;border:1px solid rgba(255,255,255,.55);padding:.7em 1em}

/* ---------- 3 logo suite ---------- */
.suite{flex:1;display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:1fr 1fr;gap:calc(var(--u)*1.4);min-height:0}
.tile{display:flex;flex-direction:column;min-width:0;min-height:0}
.tile .art{flex:1;display:flex;align-items:center;justify-content:center;padding:calc(var(--u)*2.2);min-height:0}
.tile .art img{max-height:100%;max-width:100%;object-fit:contain}
.tile.wide .art img{width:82%}
.tile .art.on-white{background:var(--white);border:1px solid var(--hair)}
.tile .art.on-red{background:var(--red)}
.tile .cap{display:flex;justify-content:space-between;gap:8px;padding-top:calc(var(--u)*.7)}
.tile .cap b{font-weight:600;font-size:var(--t-small)}
.tile .cap span{font-size:var(--t-small);color:var(--muted)}
.tile .art.square img{height:calc(var(--u)*13)}

/* ---------- 4 symbolism ---------- */
.symbol{flex:1;display:grid;grid-template-columns:1fr calc(var(--u)*28) 1fr;gap:calc(var(--u)*3.5);align-items:center;min-height:0}
.symbol .col{display:flex;flex-direction:column;gap:calc(var(--u)*2.4);min-width:0}
.symbol .col.left{text-align:right}
.symbol .col.left p{margin-left:auto}
.sym h3{font-size:max(15px,calc(var(--u)*1.3));display:flex;gap:.6em;align-items:baseline;margin-bottom:4px}
.col.left .sym h3{justify-content:flex-end}
.sym h3 i{font-style:normal;font-weight:800;color:var(--red);font-size:var(--t-small);letter-spacing:.1em}
.sym p{font-size:var(--t-body);line-height:1.6;max-width:44ch}
.symbol .centre{display:flex;flex-direction:column;align-items:center;gap:calc(var(--u)*2)}
.symbol .centre img{width:100%}
.overall{display:grid;grid-template-columns:auto 1fr;gap:calc(var(--u)*3);align-items:center;border-top:1px solid var(--hair);padding-top:calc(var(--u)*1.4);margin-top:calc(var(--u)*1.2)}
.overall .label{color:var(--red)}
.overall p{max-width:none;color:var(--ink)}

/* ---------- 5 colour ---------- */
.colour{flex:1;display:grid;grid-template-columns:1.6fr 1fr;gap:calc(var(--u)*1.4);min-height:0}
.swatch{display:flex;flex-direction:column;justify-content:space-between;padding:calc(var(--u)*2.6);min-width:0}
.swatch.red{background:var(--red);color:var(--white)}
.swatch.white{background:var(--white);border:1px solid var(--hair);color:var(--ink)}
.swatch .name{font-weight:800;font-size:var(--t-h2);letter-spacing:-.01em}
.swatch .role{font-size:var(--t-small);margin-top:6px;opacity:.85;max-width:34ch;line-height:1.5}
.codes{display:grid;grid-template-columns:repeat(3,auto);justify-content:start;gap:calc(var(--u)*.6) calc(var(--u)*3);font-variant-numeric:tabular-nums}
.codes dt{font-weight:600;font-size:var(--t-label);letter-spacing:.3em;opacity:.75}
.codes dd{margin:0;font-weight:600;font-size:var(--t-h3)}
.codes .pair{display:flex;flex-direction:column;gap:4px}
.hex{font-weight:800;font-size:var(--t-mega);letter-spacing:-.02em;line-height:1}
.swatch.white .hex{color:var(--ink)}
.colour-notes{display:grid;grid-template-columns:1.6fr 1fr;gap:calc(var(--u)*1.4);margin-top:calc(var(--u)*1.4)}
.ratio{display:flex;flex-direction:column;gap:8px}
.ratio .bar{display:flex;height:max(14px,calc(var(--u)*1.2))}
.ratio .bar span:first-child{flex:6;background:var(--white);border:1px solid var(--hair);border-right:0}
.ratio .bar span:last-child{flex:4;background:var(--red)}
.ratio .legend{display:flex;justify-content:space-between;font-size:var(--t-small);color:var(--muted)}
.contrast{display:flex;gap:calc(var(--u)*1.2);align-items:center}
.contrast .chip{background:var(--red);color:var(--white);font-weight:800;font-size:var(--t-h3);padding:.5em .8em;font-variant-numeric:tabular-nums}
.contrast p{font-size:var(--t-small);line-height:1.5}

/* ---------- 6 typography ---------- */
.type{flex:1;display:grid;grid-template-columns:calc(var(--u)*30) 1fr;gap:calc(var(--u)*4);min-height:0}
.specimen{background:var(--red);color:var(--white);display:flex;flex-direction:column;justify-content:space-between;padding:calc(var(--u)*2.6);min-width:0}
.specimen .aa{font-weight:800;font-size:calc(var(--u)*15);line-height:.9;letter-spacing:-.03em}
.specimen .family{font-weight:800;font-size:var(--t-h2)}
.specimen .label{color:rgba(255,255,255,.8)}
.specimen .glyphs{font-weight:600;font-size:var(--t-small);line-height:1.7;letter-spacing:.06em;opacity:.92}
.weights{display:flex;flex-direction:column;min-width:0}
.weight{display:grid;grid-template-columns:calc(var(--u)*13) 1fr;gap:calc(var(--u)*2);padding-block:calc(var(--u)*2.1);border-bottom:1px solid var(--hair);align-items:center}
.weight:first-child{border-top:2px solid var(--ink)}
.weight{flex:1}
.weight .meta b{display:block;font-weight:600;font-size:var(--t-h3)}
.weight .meta span{font-size:var(--t-small);color:var(--muted);line-height:1.5;display:block;margin-top:4px}
.weight .demo{min-width:0;color:var(--ink);line-height:1.1}
.w800{font-weight:800;font-size:var(--t-mega);letter-spacing:-.01em}
.w600{font-weight:600;font-size:var(--t-hero);letter-spacing:.32em;text-transform:uppercase}
.w500{font-weight:500;font-size:var(--t-body);line-height:1.62!important;color:var(--muted)!important;max-width:58ch}
.scale{margin-top:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:calc(var(--u)*1.4);padding-top:calc(var(--u)*1.6)}
.scale div{display:flex;flex-direction:column;gap:4px;min-width:0}
.scale b{font-weight:600;font-size:var(--t-small)}
.scale span{font-size:var(--t-small);color:var(--muted);font-variant-numeric:tabular-nums}

/* ---------- 7 usage ---------- */
.usage{flex:1;display:grid;grid-template-columns:1fr 1.25fr;gap:calc(var(--u)*4);min-height:0}
.usage h3{margin-bottom:calc(var(--u)*1)}
.clear{display:flex;flex-direction:column;min-width:0}
.cs-wrap{flex:1;display:flex;align-items:center;justify-content:center;background:#fbf6f6;border:1px solid var(--hair);min-height:0;padding:calc(var(--u)*1.5)}
.cs{position:relative;padding:calc(var(--u)*2.4);outline:1px dashed var(--red);outline-offset:0}
.cs img{display:block;height:calc(var(--u)*16);width:auto;outline:1px solid rgba(196,22,24,.35)}
.cs .x{position:absolute;font-weight:800;font-size:var(--t-small);color:var(--red);font-style:italic}
.cs .x.t{top:calc(var(--u)*.6);left:50%;transform:translateX(-50%)}
.cs .x.l{left:calc(var(--u)*.9);top:50%;transform:translateY(-50%)}
.cs .x.r{right:calc(var(--u)*.9);top:50%;transform:translateY(-50%)}
.cs .x.b{bottom:calc(var(--u)*.6);left:50%;transform:translateX(-50%)}
.clear p{font-size:var(--t-small);margin-top:calc(var(--u)*1)}
.minsize{display:grid;grid-template-columns:repeat(3,1fr);gap:calc(var(--u)*1);margin-top:calc(var(--u)*1.4);border-top:2px solid var(--ink);padding-top:calc(var(--u)*1)}
.minsize div{display:flex;flex-direction:column;gap:3px}
.minsize b{font-weight:600;font-size:var(--t-small)}
.minsize span{font-size:var(--t-small);color:var(--muted);font-variant-numeric:tabular-nums}
.donts{display:flex;flex-direction:column;min-width:0}
.dgrid{flex:1;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:1fr 1fr;gap:calc(var(--u)*1.2);min-height:0}
.dont{display:flex;flex-direction:column;min-width:0;min-height:0}
.dont .art{flex:1;position:relative;display:flex;align-items:center;justify-content:center;border:1px solid var(--hair);overflow:hidden;min-height:0;padding:calc(var(--u)*1)}
.dont .art img{height:calc(var(--u)*7.5);width:auto;max-width:none}
.dont .art::after{content:"";position:absolute;inset:0;background:linear-gradient(to top right,transparent calc(50% - 1px),rgba(196,22,24,.75) 50%,transparent calc(50% + 1px))}
.dont .cap{font-size:var(--t-small);padding-top:calc(var(--u)*.6);color:var(--ink);font-weight:600}
.dont .cap span{color:var(--red);margin-right:.4em}
.d-stretch img{transform:scaleX(1.55)}
.d-colour img{filter:hue-rotate(205deg) saturate(.8)}
.d-rotate img{transform:rotate(-18deg)}
.d-shadow img{filter:drop-shadow(5px 6px 3px rgba(0,0,0,.55))}
.d-busy{background:url(data:image/jpeg;base64,) center/cover}
.d-busy img{opacity:.95}
.d-lowc{background:#e2504f}
.do{display:flex;gap:calc(var(--u)*1.2);margin-top:calc(var(--u)*1.2)}
.do span{flex:1;font-size:var(--t-small);color:var(--muted);line-height:1.5;border-top:1px solid var(--hair);padding-top:calc(var(--u)*.8)}
.do b{color:var(--ink);font-weight:600}

/* ---------- 8 applications ---------- */
.apps{flex:1;display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:1fr 1fr;gap:calc(var(--u)*1);min-height:0}
.apps figure{margin:0;position:relative;overflow:hidden;min-height:0;min-width:0;background:var(--desk)}
.apps figure img{width:100%;height:100%;object-fit:cover;display:block}
.apps figcaption{position:absolute;left:0;bottom:0;background:var(--white);color:var(--ink);font-weight:600;font-size:var(--t-label);letter-spacing:.28em;text-transform:uppercase;padding:.9em 1.2em}
.apps .span2{grid-column:span 2}

/* ---------- 9 close ---------- */
.close{background:var(--red);color:var(--white);align-items:center;justify-content:center;text-align:center;gap:calc(var(--u)*2.6)}
.close img{width:calc(var(--u)*17)}
.close h2{font-size:var(--t-hero);max-width:22ch}
.close .label{color:rgba(255,255,255,.82)}
.close .end{position:absolute;bottom:calc(var(--u)*3.6);left:calc(var(--u)*4.4);right:calc(var(--u)*4.4);display:flex;justify-content:space-between;border-top:1px solid rgba(255,255,255,.35);padding-top:calc(var(--u)*1.2)}

.note{max-width:1440px;width:100%;font-size:13px;color:var(--muted);line-height:1.6}

/* ---------- narrow screens: sheets become flowing sections ---------- */
@media (max-width:760px){
  .deck{gap:20px;padding-block:20px 40px}
  .page{aspect-ratio:auto}
  .sheet{--u:6px;position:relative;inset:auto;padding:28px 20px}
  .essence,.suite,.symbol,.colour,.colour-notes,.type,.usage,.overall{grid-template-columns:1fr}
  .suite,.apps,.dgrid{grid-template-rows:none}
  .suite .tile .art{min-height:160px}
  .tile .art.square img{height:120px}
  .apps{grid-template-columns:1fr 1fr}
  .apps figure{aspect-ratio:4/3}
  .apps .span2{grid-column:span 2}
  .dgrid{grid-template-columns:1fr 1fr}
  .dont .art{min-height:110px}
  .focus{grid-template-columns:1fr 1fr;row-gap:16px}
  .symbol .col.left{text-align:left}.col.left .sym h3{justify-content:flex-start}.symbol .col.left p{margin-left:0}
  .symbol .centre{order:-1}.symbol .centre img{width:60%}
  .weight{grid-template-columns:1fr}
  .scale{grid-template-columns:1fr 1fr}
  .cover{min-height:520px}
  .cover .top,.cover .bottom{flex-direction:column;align-items:flex-start}
  .close{min-height:520px;padding-bottom:110px}
  .cs-wrap{min-height:220px}
  .swatch{min-height:240px;gap:24px}
  .specimen .aa{font-size:110px}
  .head img{display:none}
}

@media print{
  @page{size:1440px 900px;margin:0}
  html,body{background:var(--white)}
  :root{padding:0!important}
  .deck{display:block;padding:0}
  .page{width:1440px;height:900px;max-width:none;aspect-ratio:auto;box-shadow:none;break-after:page;page-break-after:always}
  .page:last-of-type{break-after:auto;page-break-after:auto}
  .note{display:none}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

