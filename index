        <div class="tile wide"><div class="art on-white"><img data-a="lockup-red" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="Primary lockup, red on white"></div><div class="cap"><b>Primary Lockup</b><span>Red on white</span></div></div>
